# Local preview and private mail files
HOST=127.0.0.1
PORT=4080
PUBLIC_URL=http://127.0.0.1:4080
DATA_DIR=./data
REVIEWER_ID=editor
CALLBACK_OWNER=taos-city-lead
REVIEWER_PASSWORD=
# Neon Postgres and private Object Storage. Pull these with neon env pull.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# NEON_MEDIA_BUCKET=uploads
# CATALOG_DIR=../ArtSouthwest-website/production-release
# ARTIST_ORIGIN=https://artist.artsouthwest.com
# CURATOR_ORIGIN=https://curator.artsouthwest.com
# CATALOG_ORIGIN=https://artsouthwest.com
# MAIL_DISABLED=1
# ITINERARY_OPENAI_API_KEY=
# ITINERARY_OPENAI_MODEL=gpt-4o-mini
# Required for a public HTTPS deployment. See README.
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# SMTP_URL=
# MAIL_FROM=
# REPLY_TO=
# MAIL_QUEUE_KEY=

# MVP2 editorial preview. Leave jobs and sends off in local development.
