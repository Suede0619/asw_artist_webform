{
  "name": "asw-artist-webform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "retention": "node --env-file-if-exists=.env scripts/retention.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "vite": "8.3.8"
  }
}
